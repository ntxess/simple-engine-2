# simple-engine-2 ignore rules
#
# Every pattern below starts with "/", so it only matches at the repository root.
# The vendored trees under dep/ are committed exactly as released, so no rule here
# may reach inside them. (The old Visual Studio template's unanchored patterns,
# such as config/, build/, [Ll]og/ and Win32/, silently dropped required files there.)

# Build trees and IDE state
/build/
/out/
/.deps/
/.vs/
/.cache/
/.vscode/*
!/.vscode/tasks.json

# Written by the engine and editor at runtime (paths are relative to the repo root)
/log/
/save/
/imgui.ini

# Boost's local build output (not part of the Boost release): b2 intermediates,
# and the object files and binary left by bootstrapping the b2 engine
/dep/boost_1_90_0/bin.v2/
/dep/boost_1_90_0/tools/build/src/engine/*.obj
/dep/boost_1_90_0/tools/build/src/engine/b2.exe
# npm packages under four Boost libraries' doc sources (~10k files, unused by the build)
/dep/boost_1_90_0/libs/*/doc/node_modules/

# Editor backup files, anywhere
*~

# Python bytecode from running the tools and their tests
__pycache__/
