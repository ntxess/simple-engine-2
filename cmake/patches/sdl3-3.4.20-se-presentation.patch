+
+// Device creation hooks
+
+static bool SDL_SE_VULKAN_HasExtension(const VkExtensionProperties *extensions, Uint32 count, const char *name)
+{
+    for (Uint32 i = 0; i < count; i += 1) {
+        if (SDL_strcmp(extensions[i].extensionName, name) == 0) {
+            return true;
+        }
+    }
+    return false;
+}
+
+static bool SDL_SE_VULKAN_IsRequested(const VkDeviceCreateInfo *createInfo, const char *name)
+{
+    for (Uint32 i = 0; i < createInfo->enabledExtensionCount; i += 1) {
+        if (SDL_strcmp(createInfo->ppEnabledExtensionNames[i], name) == 0) {
+            return true;
+        }
+    }
+    return false;
+}
+
+static void SDL_SE_VULKAN_PrepareDeviceCreate(VulkanRenderer *renderer, VkDeviceCreateInfo *createInfo, SDL_SE_VulkanDeviceCreate *data)
+{
+    VkExtensionProperties *extensions;
+    Uint32 extensionCount = 0;
+    bool havePresentId, havePresentWait, haveDisplayTiming;
+    Uint32 count;
+
+    SDL_zerop(data);
+    data->originalExtensionNames = createInfo->ppEnabledExtensionNames;
+    data->originalExtensionCount = createInfo->enabledExtensionCount;
+    data->originalNext = createInfo->pNext;
+
+    if (renderer->vkEnumerateDeviceExtensionProperties(renderer->physicalDevice, NULL, &extensionCount, NULL) != VK_SUCCESS ||
+        extensionCount == 0) {
+        return;
+    }
+    extensions = (VkExtensionProperties *)SDL_malloc(extensionCount * sizeof(VkExtensionProperties));
+    if (extensions == NULL) {
+        return;
+    }
+    if (renderer->vkEnumerateDeviceExtensionProperties(renderer->physicalDevice, NULL, &extensionCount, extensions) != VK_SUCCESS) {
+        SDL_free(extensions);
+        return;
+    }
+    // Extensions an application already requested through
+    // SDL_PROP_GPU_DEVICE_CREATE_VULKAN_OPTIONS_POINTER are left alone.
+    havePresentId = SDL_SE_VULKAN_HasExtension(extensions, extensionCount, VK_KHR_PRESENT_ID_EXTENSION_NAME) &&
+                    !SDL_SE_VULKAN_IsRequested(createInfo, VK_KHR_PRESENT_ID_EXTENSION_NAME);
+    havePresentWait = SDL_SE_VULKAN_HasExtension(extensions, extensionCount, VK_KHR_PRESENT_WAIT_EXTENSION_NAME) &&
+                      !SDL_SE_VULKAN_IsRequested(createInfo, VK_KHR_PRESENT_WAIT_EXTENSION_NAME);
+    haveDisplayTiming = SDL_SE_VULKAN_HasExtension(extensions, extensionCount, VK_GOOGLE_DISPLAY_TIMING_EXTENSION_NAME) &&
+                        !SDL_SE_VULKAN_IsRequested(createInfo, VK_GOOGLE_DISPLAY_TIMING_EXTENSION_NAME);
+    SDL_free(extensions);
+
+    // present_id and present_wait are features as well as extensions; their
+    // query needs VK_KHR_get_physical_device_properties2 on a 1.0 instance.
+    if (havePresentId && renderer->supportsPhysicalDeviceProperties2) {
+        PFN_vkGetPhysicalDeviceFeatures2KHR getFeatures2 =
+            (PFN_vkGetPhysicalDeviceFeatures2KHR)vkGetInstanceProcAddr(renderer->instance, "vkGetPhysicalDeviceFeatures2KHR");
+        if (getFeatures2 != NULL) {
+            VkPhysicalDevicePresentWaitFeaturesKHR waitFeatures;
+            VkPhysicalDevicePresentIdFeaturesKHR idFeatures;
+            VkPhysicalDeviceFeatures2 features2;
+            SDL_zero(waitFeatures);
+            SDL_zero(idFeatures);
+            SDL_zero(features2);
+            waitFeatures.sType = VK_STRUCTURE_TYPE_PHYSICAL_DEVICE_PRESENT_WAIT_FEATURES_KHR;
+            idFeatures.sType = VK_STRUCTURE_TYPE_PHYSICAL_DEVICE_PRESENT_ID_FEATURES_KHR;
+            idFeatures.pNext = havePresentWait ? &waitFeatures : NULL;
+            features2.sType = VK_STRUCTURE_TYPE_PHYSICAL_DEVICE_FEATURES_2;
+            features2.pNext = &idFeatures;
+            getFeatures2(renderer->physicalDevice, &features2);
+            data->presentId = idFeatures.presentId == VK_TRUE;
+            data->presentWait = data->presentId && havePresentWait && waitFeatures.presentWait == VK_TRUE;
+        }
+    }
+    data->displayTiming = haveDisplayTiming;
+
+    count = data->presentId + data->presentWait + data->displayTiming;
+    if (count == 0) {
+        return;
+    }
+    data->extensionNames = (const char **)SDL_malloc((data->originalExtensionCount + SDL_SE_VULKAN_MAX_ADDED_EXTENSIONS) * sizeof(const char *));
+    if (data->extensionNames == NULL) {
+        data->presentId = data->presentWait = data->displayTiming = false;
+        return;
+    }
+    count = 0;
+    for (Uint32 i = 0; i < data->originalExtensionCount; i += 1) {
+        data->extensionNames[count++] = data->originalExtensionNames[i];
+    }
+    if (data->presentId) {
+        data->extensionNames[count++] = VK_KHR_PRESENT_ID_EXTENSION_NAME;
+        data->presentIdFeatures.sType = VK_STRUCTURE_TYPE_PHYSICAL_DEVICE_PRESENT_ID_FEATURES_KHR;
+        data->presentIdFeatures.pNext = (void *)createInfo->pNext;
+        data->presentIdFeatures.presentId = VK_TRUE;
+        createInfo->pNext = &data->presentIdFeatures;
+    }
+    if (data->presentWait) {
+        data->extensionNames[count++] = VK_KHR_PRESENT_WAIT_EXTENSION_NAME;
+        data->presentWaitFeatures.sType = VK_STRUCTURE_TYPE_PHYSICAL_DEVICE_PRESENT_WAIT_FEATURES_KHR;
+        data->presentWaitFeatures.pNext = (void *)createInfo->pNext;
+        data->presentWaitFeatures.presentWait = VK_TRUE;
+        createInfo->pNext = &data->presentWaitFeatures;
+    }
+    if (data->displayTiming) {
+        data->extensionNames[count++] = VK_GOOGLE_DISPLAY_TIMING_EXTENSION_NAME;
+    }
+    createInfo->enabledExtensionCount = count;
+    createInfo->ppEnabledExtensionNames = data->extensionNames;
+}
+
+static bool SDL_SE_VULKAN_RevertDeviceCreate(VkDeviceCreateInfo *createInfo, SDL_SE_VulkanDeviceCreate *data)
+{
+    bool changed = data->presentId || data->presentWait || data->displayTiming;
+    createInfo->ppEnabledExtensionNames = data->originalExtensionNames;
+    createInfo->enabledExtensionCount = data->originalExtensionCount;
+    createInfo->pNext = data->originalNext;
+    data->presentId = data->presentWait = data->displayTiming = false;
+    if (changed) {
+        SDL_LogWarn(SDL_LOG_CATEGORY_GPU, "Vulkan: device creation failed with the optional presentation extensions; retrying without them");
+    }
+    return changed;
+}
+
+#define SDL_SE_VULKAN_LOAD_DEVICE_FUNCTION(func) \
+    renderer->se.func = (PFN_##func)renderer->vkGetDeviceProcAddr(renderer->logicalDevice, #func)
+
+static void SDL_SE_VULKAN_FinishDeviceCreate(VulkanRenderer *renderer, SDL_SE_VulkanDeviceCreate *data, bool created)
+{
+    SDL_free((void *)data->extensionNames);
+    data->extensionNames = NULL;
+    if (!created) {
+        return;
+    }
+
+    if (data->presentWait) {
+        SDL_SE_VULKAN_LOAD_DEVICE_FUNCTION(vkWaitForPresentKHR);
+    }
+    renderer->se.presentId = data->presentId;
+    renderer->se.presentWait = data->presentWait && renderer->se.vkWaitForPresentKHR != NULL;
+    if (data->displayTiming) {
+        SDL_SE_VULKAN_LOAD_DEVICE_FUNCTION(vkGetPastPresentationTimingGOOGLE);
+        SDL_SE_VULKAN_LOAD_DEVICE_FUNCTION(vkGetRefreshCycleDurationGOOGLE);
+    }
+    renderer->se.displayTiming = data->displayTiming &&
+                                 renderer->se.vkGetPastPresentationTimingGOOGLE != NULL &&
+                                 renderer->se.vkGetRefreshCycleDurationGOOGLE != NULL;
+
+    // Timestamp queries are core: they need a queue family with valid bits.
+    SDL_SE_VULKAN_LOAD_DEVICE_FUNCTION(vkCreateQueryPool);
+    SDL_SE_VULKAN_LOAD_DEVICE_FUNCTION(vkDestroyQueryPool);
+    SDL_SE_VULKAN_LOAD_DEVICE_FUNCTION(vkCmdResetQueryPool);
+    SDL_SE_VULKAN_LOAD_DEVICE_FUNCTION(vkCmdWriteTimestamp);
+    SDL_SE_VULKAN_LOAD_DEVICE_FUNCTION(vkGetQueryPoolResults);
+    renderer->se.timestampPeriod = renderer->physicalDeviceProperties.properties.limits.timestampPeriod;
+    {
+        Uint32 familyCount = 0;
+        VkQueueFamilyProperties *families;
+        renderer->vkGetPhysicalDeviceQueueFamilyProperties(renderer->physicalDevice, &familyCount, NULL);
+        families = (VkQueueFamilyProperties *)SDL_malloc(SDL_max(familyCount, 1) * sizeof(VkQueueFamilyProperties));
+        if (families != NULL) {
+            renderer->vkGetPhysicalDeviceQueueFamilyProperties(renderer->physicalDevice, &familyCount, families);
+            if (renderer->queueFamilyIndex < familyCount) {
+                renderer->se.timestampValidBits = families[renderer->queueFamilyIndex].timestampValidBits;
+            }
+            SDL_free(families);
+        }
+    }
+    if (renderer->se.timestampValidBits == 0 || renderer->se.timestampPeriod <= 0.0f ||
+        renderer->se.vkCreateQueryPool == NULL || renderer->se.vkCmdWriteTimestamp == NULL ||
+        renderer->se.vkCmdResetQueryPool == NULL || renderer->se.vkGetQueryPoolResults == NULL) {
+        renderer->se.timestampsFailed = true;
+    }
+}
+
+#undef SDL_SE_VULKAN_LOAD_DEVICE_FUNCTION
+
+// Swapchain and present hooks
+
+static void SDL_SE_VULKAN_OnSwapchainCreated(WindowData *windowData)
+{
+    windowData->se.firstPresentIdOfSwapchain = 0;
+    windowData->se.haveDisplayTiming = false;
+    windowData->se.refreshDuration = 0;
+    windowData->se.baseActualPresentTime = 0;
+    windowData->se.baseRefreshCount = 0;
+}
+
+static const void *SDL_SE_VULKAN_PresentNext(VulkanRenderer *renderer, WindowData *windowData, SDL_SE_VulkanPresentChain *chain)
+{
+    const void *next = NULL;
+    Uint64 id;
+
+    windowData->se.presentCount += 1;
+    id = windowData->se.presentCount;
+
+    if (renderer->se.presentId && windowData->se.frameLatency > 0) {
+        chain->presentIdValue = id;
+        chain->presentId.sType = VK_STRUCTURE_TYPE_PRESENT_ID_KHR;
+        chain->presentId.pNext = next;
+        chain->presentId.swapchainCount = 1;
+        chain->presentId.pPresentIds = &chain->presentIdValue;
+        next = &chain->presentId;
+        windowData->se.lastPresentId = id;
+        if (windowData->se.firstPresentIdOfSwapchain == 0) {
+            windowData->se.firstPresentIdOfSwapchain = id;
+        }
+    }
+    if (renderer->se.displayTiming && windowData->se.displayTimingRequested) {
+        chain->presentTime.presentID = (Uint32)id;
+        chain->presentTime.desiredPresentTime = 0;
+        chain->presentTimes.sType = VK_STRUCTURE_TYPE_PRESENT_TIMES_INFO_GOOGLE;
+        chain->presentTimes.pNext = next;
+        chain->presentTimes.swapchainCount = 1;
+        chain->presentTimes.pTimes = &chain->presentTime;
+        next = &chain->presentTimes;
+    }
+    return next;
+}
+
+// Status hooks
+
+static void SDL_SE_VULKAN_OnResult(VulkanRenderer *renderer, VkResult result)
+{
+    if (result == VK_ERROR_DEVICE_LOST) {
+        SDL_SetAtomicInt(&renderer->se.deviceLost, 1);
+    }
+}
+
+// Timing hooks
+
+static void SDL_SE_VULKAN_ReleaseTimingSlot(VulkanRenderer *renderer, Uint32 slot)
+{
+    SDL_SE_VulkanTimingSlot *timing = &renderer->se.timingSlots[slot];
+    if (timing->fence != NULL) {
+        VULKAN_ReleaseFence((SDL_GPURenderer *)renderer, (SDL_GPUFence *)timing->fence);
+        timing->fence = NULL;
+    }
+    timing->inUse = false;
+}
+
+static bool SDL_SE_VULKAN_EnsureTimestamps(VulkanRenderer *renderer)
+{
+    VkQueryPoolCreateInfo createInfo;
+    VkResult result;
+
+    if (renderer->se.timestampPool != VK_NULL_HANDLE) {
+        return true;
+    }
+    if (renderer->se.timestampsFailed) {
+        return false;
+    }
+    SDL_zero(createInfo);
+    createInfo.sType = VK_STRUCTURE_TYPE_QUERY_POOL_CREATE_INFO;
+    createInfo.queryType = VK_QUERY_TYPE_TIMESTAMP;
+    createInfo.queryCount = 2 * SDL_SE_VULKAN_TIMING_SLOTS;
+    result = renderer->se.vkCreateQueryPool(renderer->logicalDevice, &createInfo, NULL, &renderer->se.timestampPool);
+    if (result != VK_SUCCESS) {
+        SDL_SE_VULKAN_OnResult(renderer, result);
+        renderer->se.timestampPool = VK_NULL_HANDLE;
+        renderer->se.timestampsFailed = true;
+        SDL_SetError("vkCreateQueryPool %s", VkErrorMessages(result));
+        return false;
+    }
+    return true;
+}
+
+static void SDL_SE_VULKAN_BeginTiming(SDL_GPUCommandBuffer *commandBuffer)
+{
+    VulkanCommandBuffer *vulkanCommandBuffer = (VulkanCommandBuffer *)commandBuffer;
+    VulkanRenderer *renderer = vulkanCommandBuffer->renderer;
+    Uint32 slot = SDL_SE_VULKAN_TIMING_SLOTS;
+
+    if (vulkanCommandBuffer->se.timingBegun) {
+        return;
+    }
+
+    SDL_LockMutex(renderer->submitLock);
+    if (SDL_SE_VULKAN_EnsureTimestamps(renderer)) {
+        // The oldest slot that no command buffer is recording into; a result
+        // nobody read is dropped.
+        for (Uint32 i = 0; i < SDL_SE_VULKAN_TIMING_SLOTS; i += 1) {
+            Uint32 candidate = (renderer->se.nextTimingSlot + i) % SDL_SE_VULKAN_TIMING_SLOTS;
+            if (!renderer->se.timingSlots[candidate].inUse || renderer->se.timingSlots[candidate].fence != NULL) {
+                slot = candidate;
+                break;
+            }
+        }
+        if (slot < SDL_SE_VULKAN_TIMING_SLOTS) {
+            SDL_SE_VULKAN_ReleaseTimingSlot(renderer, slot);
+            renderer->se.timingSlots[slot].inUse = true;
+            renderer->se.nextTimingSlot = (slot + 1) % SDL_SE_VULKAN_TIMING_SLOTS;
+        }
+    }
+    SDL_UnlockMutex(renderer->submitLock);
+
+    if (slot >= SDL_SE_VULKAN_TIMING_SLOTS) {
+        return;
+    }
+    vulkanCommandBuffer->se.timingSlot = slot;
+    vulkanCommandBuffer->se.timingBegun = true;
+    vulkanCommandBuffer->se.timingEnded = false;
+    // Outside any render pass (checked by SDL_SE_BeginGPUTiming).
+    renderer->se.vkCmdResetQueryPool(vulkanCommandBuffer->commandBuffer, renderer->se.timestampPool, 2 * slot, 2);
+    renderer->se.vkCmdWriteTimestamp(vulkanCommandBuffer->commandBuffer, VK_PIPELINE_STAGE_TOP_OF_PIPE_BIT, renderer->se.timestampPool, 2 * slot);
+}
+
+static void SDL_SE_VULKAN_EndTiming(SDL_GPUCommandBuffer *commandBuffer)
+{
+    VulkanCommandBuffer *vulkanCommandBuffer = (VulkanCommandBuffer *)commandBuffer;
+    VulkanRenderer *renderer = vulkanCommandBuffer->renderer;
+
+    if (!vulkanCommandBuffer->se.timingBegun || vulkanCommandBuffer->se.timingEnded) {
+        return;
+    }
+    vulkanCommandBuffer->se.timingEnded = true;
+    renderer->se.vkCmdWriteTimestamp(
+        vulkanCommandBuffer->commandBuffer,
+        VK_PIPELINE_STAGE_BOTTOM_OF_PIPE_BIT,
+        renderer->se.timestampPool,
+        2 * vulkanCommandBuffer->se.timingSlot + 1);
+}
+
+static void SDL_SE_VULKAN_OnSubmitRecording(VulkanCommandBuffer *commandBuffer)
+{
+    SDL_SE_VULKAN_EndTiming((SDL_GPUCommandBuffer *)commandBuffer);
+}
+
+static void SDL_SE_VULKAN_OnSubmitFence(VulkanCommandBuffer *commandBuffer)
+{
+    VulkanRenderer *renderer = commandBuffer->renderer;
+    SDL_SE_VulkanTimingSlot *timing;
+
+    if (!commandBuffer->se.timingBegun) {
+        return;
+    }
+    timing = &renderer->se.timingSlots[commandBuffer->se.timingSlot];
+    timing->fence = commandBuffer->inFlightFence;
+    (void)SDL_AtomicIncRef(&timing->fence->referenceCount);
+    SDL_zero(commandBuffer->se);
+}
+
+static void SDL_SE_VULKAN_OnCancel(VulkanCommandBuffer *commandBuffer)
+{
+    if (commandBuffer->se.timingBegun) {
+        SDL_SE_VULKAN_ReleaseTimingSlot(commandBuffer->renderer, commandBuffer->se.timingSlot);
+    }
+    SDL_zero(commandBuffer->se);
+}
+
+static bool SDL_SE_VULKAN_GetTiming(SDL_GPURenderer *driverData, SDL_GPUFence *fence, Uint64 *duration_ns)
+{
+    VulkanRenderer *renderer = (VulkanRenderer *)driverData;
+    VulkanFenceHandle *handle = (VulkanFenceHandle *)fence;
+    Uint32 slot = SDL_SE_VULKAN_TIMING_SLOTS;
+    Uint64 timestamps[2] = { 0, 0 };
+    Uint64 mask, ticks;
+    VkResult result;
+    bool ok = false;
+
+    SDL_LockMutex(renderer->submitLock);
+    for (Uint32 i = 0; i < SDL_SE_VULKAN_TIMING_SLOTS; i += 1) {
+        if (renderer->se.timingSlots[i].fence == handle) {
+            slot = i;
+            break;
+        }
+    }
+    if (slot >= SDL_SE_VULKAN_TIMING_SLOTS) {
+        SDL_UnlockMutex(renderer->submitLock);
+        return SDL_SetError("No GPU timing is pending for this fence");
+    }
+    result = renderer->vkGetFenceStatus(renderer->logicalDevice, handle->fence);
+    if (result != VK_SUCCESS) {
+        SDL_SE_VULKAN_OnResult(renderer, result);
+        SDL_UnlockMutex(renderer->submitLock);
+        return false;
+    }
+    result = renderer->se.vkGetQueryPoolResults(
+        renderer->logicalDevice,
+        renderer->se.timestampPool,
+        2 * slot,
+        2,
+        sizeof(timestamps),
+        timestamps,
+        sizeof(Uint64),
+        VK_QUERY_RESULT_64_BIT);
+    if (result == VK_SUCCESS) {
+        mask = renderer->se.timestampValidBits >= 64 ? ~(Uint64)0 : (((Uint64)1 << renderer->se.timestampValidBits) - 1);
+        ticks = ((timestamps[1] & mask) - (timestamps[0] & mask)) & mask;
+        *duration_ns = (Uint64)((double)ticks * (double)renderer->se.timestampPeriod);
+        ok = true;
+    } else {
+        SDL_SE_VULKAN_OnResult(renderer, result);
+        SDL_SetError("vkGetQueryPoolResults %s", VkErrorMessages(result));
+    }
+    SDL_SE_VULKAN_ReleaseTimingSlot(renderer, slot);
+    SDL_UnlockMutex(renderer->submitLock);
+    return ok;
+}
+
+static void SDL_SE_VULKAN_DestroyDevice(VulkanRenderer *renderer)
+{
+    for (Uint32 i = 0; i < SDL_SE_VULKAN_TIMING_SLOTS; i += 1) {
+        SDL_SE_VULKAN_ReleaseTimingSlot(renderer, i);
+    }
+    if (renderer->se.timestampPool != VK_NULL_HANDLE) {
+        renderer->se.vkDestroyQueryPool(renderer->logicalDevice, renderer->se.timestampPool, NULL);
+        renderer->se.timestampPool = VK_NULL_HANDLE;
+    }
+    if (renderer->se.statusFence != VK_NULL_HANDLE) {
+        renderer->vkDestroyFence(renderer->logicalDevice, renderer->se.statusFence, NULL);
+        renderer->se.statusFence = VK_NULL_HANDLE;
+    }
+}
+
+// Frame latency and present statistics
+
+static bool SDL_SE_VULKAN_SetFrameLatency(SDL_GPURenderer *driverData, SDL_Window *window, Uint32 frames)
+{
+    VulkanRenderer *renderer = (VulkanRenderer *)driverData;
+    WindowData *windowData = VULKAN_INTERNAL_FetchWindowData(window);
+
+    if (windowData == NULL || windowData->renderer != renderer) {
+        SET_STRING_ERROR_AND_RETURN("Cannot set the frame latency of an unclaimed window!", false);
+    }
+    if (!renderer->se.presentId || !renderer->se.presentWait) {
+        return SDL_SetError("The Vulkan device lacks VK_KHR_present_id or VK_KHR_present_wait");
+    }
+    windowData->se.frameLatency = frames;
+    return true;
+}
+
+static SDL_SE_GPUWaitResult SDL_SE_VULKAN_WaitForFrameLatency(SDL_GPURenderer *driverData, SDL_Window *window, Uint64 timeout_ns)
+{
+    VulkanRenderer *renderer = (VulkanRenderer *)driverData;
+    WindowData *windowData = VULKAN_INTERNAL_FetchWindowData(window);
+    Uint64 target;
+    VkResult result;
+
+    if (windowData == NULL || windowData->renderer != renderer || !renderer->se.presentWait ||
+        windowData->se.frameLatency == 0) {
+        return SDL_SE_GPU_WAIT_UNSUPPORTED;
+    }
+    // The next present gets id lastPresentId + 1; with a latency of L it may
+    // be queued once the present L back from it was displayed.
+    if (windowData->se.lastPresentId < windowData->se.frameLatency) {
+        return SDL_SE_GPU_WAIT_READY;
+    }
+    target = windowData->se.lastPresentId + 1 - windowData->se.frameLatency;
+    if (windowData->swapchain == VK_NULL_HANDLE || windowData->se.firstPresentIdOfSwapchain == 0 ||
+        target < windowData->se.firstPresentIdOfSwapchain) {
+        // That present went to an earlier swapchain (or none was made yet).
+        return SDL_SE_GPU_WAIT_READY;
+    }
+    result = renderer->se.vkWaitForPresentKHR(renderer->logicalDevice, windowData->swapchain, target, timeout_ns);
+    if (result == VK_SUCCESS) {
+        return SDL_SE_GPU_WAIT_READY;
+    }
+    if (result == VK_TIMEOUT) {
+        return SDL_SE_GPU_WAIT_TIMEOUT;
+    }
+    // Out of date, surface or device lost: never block on it.
+    SDL_SE_VULKAN_OnResult(renderer, result);
+    return SDL_SE_GPU_WAIT_READY;
+}
+
+// Converts a VK_GOOGLE_display_timing time into the SDL_GetTicksNS() domain.
+// The extension defines the clock as CLOCK_MONOTONIC on Linux; elsewhere the
+// times are taken as nanoseconds of the performance counter (an assumption:
+// no Windows driver on the development machine reports the extension).
+static Uint64 SDL_SE_VULKAN_PresentTimeToTicksNS(Uint64 presentTime)
+{
+#ifdef _WIN32
+    const Uint64 frequency = SDL_GetPerformanceFrequency();
+    const Uint64 counter = (presentTime / SDL_NS_PER_SECOND) * frequency +
+                           ((presentTime % SDL_NS_PER_SECOND) * frequency) / SDL_NS_PER_SECOND;
+    return SDL_SE_PerformanceCounterToTicksNS(counter);
+#else
+    struct timespec now;
+    Uint64 nowNS, ticks;
+    ticks = SDL_GetTicksNS();
+    if (clock_gettime(CLOCK_MONOTONIC, &now) != 0) {
+        return ticks;
+    }
+    nowNS = (Uint64)now.tv_sec * SDL_NS_PER_SECOND + (Uint64)now.tv_nsec;
+    if (presentTime >= nowNS) {
+        return ticks + (presentTime - nowNS);
+    }
+    return (nowNS - presentTime) < ticks ? ticks - (nowNS - presentTime) : 0;
+#endif
+}
+
+static bool SDL_SE_VULKAN_GetPresentStatistics(SDL_GPURenderer *driverData, SDL_Window *window, SDL_SE_GPUPresentStatistics *statistics)
+{
+    VulkanRenderer *renderer = (VulkanRenderer *)driverData;
+    WindowData *windowData = VULKAN_INTERNAL_FetchWindowData(window);
+    VkPastPresentationTimingGOOGLE timings[16];
+    Uint32 count = SDL_arraysize(timings);
+    VkResult result;
+    Uint64 refreshCount;
+
+    if (windowData == NULL || windowData->renderer != renderer) {
+        SET_STRING_ERROR_AND_RETURN("Cannot read present statistics of an unclaimed window!", false);
+    }
+    if (!renderer->se.displayTiming) {
+        return SDL_SetError("The Vulkan device lacks VK_GOOGLE_display_timing");
+    }
+    windowData->se.displayTimingRequested = true;
+    if (windowData->swapchain == VK_NULL_HANDLE || (SDL_GetWindowFlags(window) & SDL_WINDOW_MINIMIZED)) {
+        return false;
+    }
+
+    if (windowData->se.refreshDuration == 0) {
+        VkRefreshCycleDurationGOOGLE refresh;
+        SDL_zero(refresh);
+        result = renderer->se.vkGetRefreshCycleDurationGOOGLE(renderer->logicalDevice, windowData->swapchain, &refresh);
+        if (result != VK_SUCCESS || refresh.refreshDuration == 0) {
+            SDL_SE_VULKAN_OnResult(renderer, result);
+            return false;
+        }
+        windowData->se.refreshDuration = refresh.refreshDuration;
+    }
+
+    // Drain what the driver has; keep the newest displayed present.
+    for (;;) {
+        count = SDL_arraysize(timings);
+        result = renderer->se.vkGetPastPresentationTimingGOOGLE(renderer->logicalDevice, windowData->swapchain, &count, timings);
+        if (result != VK_SUCCESS && result != VK_INCOMPLETE) {
+            SDL_SE_VULKAN_OnResult(renderer, result);
+            break;
+        }
+        for (Uint32 i = 0; i < count; i += 1) {
+            if (!windowData->se.haveDisplayTiming || timings[i].presentID > windowData->se.lastTimingPresentId) {
+                windowData->se.lastTimingPresentId = timings[i].presentID;
+                windowData->se.lastActualPresentTime = timings[i].actualPresentTime;
+                windowData->se.haveDisplayTiming = true;
+            }
+        }
+        if (result != VK_INCOMPLETE) {
+            break;
+        }
+    }
+    if (!windowData->se.haveDisplayTiming) {
+        return false;
+    }
+
+    // Refresh counts from the displayed times: the first displayed present
+    // is refresh 1 of this swapchain.
+    if (windowData->se.baseRefreshCount == 0) {
+        windowData->se.baseActualPresentTime = windowData->se.lastActualPresentTime;
+        windowData->se.baseRefreshCount = 1;
+    }
+    refreshCount = windowData->se.baseRefreshCount;
+    if (windowData->se.lastActualPresentTime > windowData->se.baseActualPresentTime) {
+        refreshCount += (windowData->se.lastActualPresentTime - windowData->se.baseActualPresentTime +
+                         windowData->se.refreshDuration / 2) /
+                        windowData->se.refreshDuration;
+    }
+
+    // The 32-bit timing ids extend with the high bits of the present count.
+    statistics->present_count = (windowData->se.presentCount & ~(Uint64)0xFFFFFFFFu) | windowData->se.lastTimingPresentId;
+    if (statistics->present_count > windowData->se.presentCount) {
+        statistics->present_count -= (Uint64)1 << 32;
+    }
+    statistics->present_refresh_count = refreshCount;
+    statistics->sync_refresh_count = refreshCount;
+    statistics->sync_time_ns = SDL_SE_VULKAN_PresentTimeToTicksNS(windowData->se.lastActualPresentTime);
+    statistics->last_present_count = windowData->se.presentCount;
+    return true;
+}
+
+// Capabilities, status and handles
+
+static SDL_SE_GPUCapabilityFlags SDL_SE_VULKAN_GetCapabilities(SDL_GPURenderer *driverData, SDL_Window *window)
+{
+    VulkanRenderer *renderer = (VulkanRenderer *)driverData;
+    SDL_SE_GPUCapabilityFlags flags = SDL_SE_GPU_CAPABILITY_NATIVE_HANDLES | SDL_SE_GPU_CAPABILITY_DEVICE_STATUS;
+
+    if (renderer->se.presentId && renderer->se.presentWait) {
+        flags |= SDL_SE_GPU_CAPABILITY_FRAME_LATENCY_WAIT;
+    }
+    if (renderer->se.displayTiming) {
+        flags |= SDL_SE_GPU_CAPABILITY_PRESENT_STATISTICS;
+    }
+    if (!renderer->se.timestampsFailed) {
+        flags |= SDL_SE_GPU_CAPABILITY_TIMESTAMPS;
+    }
+    if (window != NULL) {
+        WindowData *windowData = VULKAN_INTERNAL_FetchWindowData(window);
+        if (windowData != NULL && windowData->renderer == renderer &&
+            VULKAN_SupportsPresentMode(driverData, window, SDL_GPU_PRESENTMODE_IMMEDIATE)) {
+            flags |= SDL_SE_GPU_CAPABILITY_TEARING;
+        }
+    }
+    return flags;
+}
+
+static SDL_SE_GPUDeviceStatus SDL_SE_VULKAN_GetDeviceStatus(SDL_GPURenderer *driverData)
+{
+    VulkanRenderer *renderer = (VulkanRenderer *)driverData;
+    VkResult result;
+
+    if (SDL_GetAtomicInt(&renderer->se.deviceLost)) {
+        return SDL_SE_GPU_DEVICE_STATUS_REMOVED;
+    }
+    // A fence that is never submitted reports VK_NOT_READY, or
+    // VK_ERROR_DEVICE_LOST once the device is lost.
+    if (renderer->se.statusFence == VK_NULL_HANDLE) {
+        VkFenceCreateInfo createInfo;
+        SDL_zero(createInfo);
+        createInfo.sType = VK_STRUCTURE_TYPE_FENCE_CREATE_INFO;
+        result = renderer->vkCreateFence(renderer->logicalDevice, &createInfo, NULL, &renderer->se.statusFence);
+        if (result != VK_SUCCESS) {
+            SDL_SE_VULKAN_OnResult(renderer, result);
+            renderer->se.statusFence = VK_NULL_HANDLE;
+            return result == VK_ERROR_DEVICE_LOST ? SDL_SE_GPU_DEVICE_STATUS_REMOVED : SDL_SE_GPU_DEVICE_STATUS_OK;
+        }
+    }
+    result = renderer->vkGetFenceStatus(renderer->logicalDevice, renderer->se.statusFence);
+    SDL_SE_VULKAN_OnResult(renderer, result);
+    return result == VK_ERROR_DEVICE_LOST ? SDL_SE_GPU_DEVICE_STATUS_REMOVED : SDL_SE_GPU_DEVICE_STATUS_OK;
+}
+
+static bool SDL_SE_VULKAN_GetNativeHandles(SDL_GPURenderer *driverData, SDL_Window *window, SDL_SE_GPUNativeHandles *handles)
+{
+    VulkanRenderer *renderer = (VulkanRenderer *)driverData;
+
+    handles->vk_instance = (void *)renderer->instance;
+    handles->vk_physical_device = (void *)renderer->physicalDevice;
+    handles->vk_device = (void *)renderer->logicalDevice;
+    handles->vk_queue = (void *)renderer->unifiedQueue;
+    handles->vk_queue_family = renderer->queueFamilyIndex;
+    if (window != NULL) {
+        WindowData *windowData = VULKAN_INTERNAL_FetchWindowData(window);
+        if (windowData != NULL && windowData->renderer == renderer) {
+            // A pointer or a 64-bit integer, by platform.
+            SDL_COMPILE_TIME_ASSERT(se_vk_swapchain_size, sizeof(windowData->swapchain) == sizeof(Uint64));
+            SDL_memcpy(&handles->vk_swapchain, &windowData->swapchain, sizeof(Uint64));
+        }
+    }
+    return true;
+}
+
+const SDL_SE_GPUBackend SDL_SE_VulkanBackend = {
+    SDL_SE_VULKAN_GetCapabilities,
+    SDL_SE_VULKAN_SetFrameLatency,
+    SDL_SE_VULKAN_WaitForFrameLatency,
+    SDL_SE_VULKAN_GetPresentStatistics,
+    SDL_SE_VULKAN_BeginTiming,
+    SDL_SE_VULKAN_EndTiming,
+    SDL_SE_VULKAN_GetTiming,
+    SDL_SE_VULKAN_GetDeviceStatus,
+    SDL_SE_VULKAN_GetNativeHandles
+};
+
+#endif // SDL_gpu_vulkan_se_impl_h_
