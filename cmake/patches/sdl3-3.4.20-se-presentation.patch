+
+/* simple-engine-2 presentation patch, Direct3D 12 part 2 of 2: the
+ * SDL_gpu_se.h backend and the hooks declared in SDL_gpu_d3d12_se.h.
+ * Included once, near the end of SDL_gpu_d3d12.c, so it sees the backend's
+ * private structures and static functions. */
+
+#ifndef SDL_gpu_d3d12_se_impl_h_
+#define SDL_gpu_d3d12_se_impl_h_
+
+static const IID D3D_IID_ID3D12QueryHeap = { 0x0d9658ae, 0xed45, 0x469e, { 0xa6, 0x1d, 0x97, 0x0e, 0xc5, 0x83, 0xca, 0xb4 } };
+
+#define SDL_SE_D3D12_TIMESTAMP_BYTES (2 * sizeof(Uint64))
+
+// Swapchain hooks
+
+#if !(defined(SDL_PLATFORM_XBOXONE) || defined(SDL_PLATFORM_XBOXSERIES))
+
+static UINT SDL_SE_D3D12_SwapchainFlags(D3D12WindowData *windowData)
+{
+    return windowData->se.frameLatency > 0 ? DXGI_SWAP_CHAIN_FLAG_FRAME_LATENCY_WAITABLE_OBJECT : 0;
+}
+
+static void SDL_SE_D3D12_OnSwapchainCreated(D3D12WindowData *windowData)
+{
+    HRESULT res;
+
+    if (windowData->se.frameLatency == 0 || windowData->swapchain == NULL) {
+        return;
+    }
+    res = IDXGISwapChain3_SetMaximumFrameLatency(windowData->swapchain, windowData->se.frameLatency);
+    if (FAILED(res)) {
+        SDL_LogWarn(SDL_LOG_CATEGORY_GPU, "SetMaximumFrameLatency(%u) failed! Error Code: " HRESULT_FMT,
+                    (unsigned int)windowData->se.frameLatency, res);
+    }
+    windowData->se.latencyWaitable = IDXGISwapChain3_GetFrameLatencyWaitableObject(windowData->swapchain);
+}
+
+static void SDL_SE_D3D12_OnSwapchainDestroyed(D3D12WindowData *windowData)
+{
+    if (windowData->se.latencyWaitable != NULL) {
+        CloseHandle(windowData->se.latencyWaitable);
+        windowData->se.latencyWaitable = NULL;
+    }
+    if (windowData->se.waitTimer != NULL) {
+        CloseHandle(windowData->se.waitTimer);
+        windowData->se.waitTimer = NULL;
+    }
+}
+
+#endif
+
+// Timing hooks
+
+static void SDL_SE_D3D12_ReleaseTimingSlot(D3D12Renderer *renderer, Uint32 slot)
+{
+    SDL_SE_D3D12TimingSlot *timing = &renderer->se.timingSlots[slot];
+    if (timing->fence != NULL) {
+        D3D12_ReleaseFence((SDL_GPURenderer *)renderer, (SDL_GPUFence *)timing->fence);
+        timing->fence = NULL;
+    }
+    timing->inUse = false;
+}
+
+static bool SDL_SE_D3D12_EnsureTimestamps(D3D12Renderer *renderer)
+{
+    D3D12_QUERY_HEAP_DESC heapDesc;
+    D3D12_HEAP_PROPERTIES heapProperties;
+    D3D12_RESOURCE_DESC bufferDesc;
+    UINT64 frequency = 0;
+    HRESULT res;
+
+    if (renderer->se.timestampHeap != NULL) {
+        return true;
+    }
+    if (renderer->se.timestampsFailed) {
+        return false;
+    }
+    renderer->se.timestampsFailed = true; // until everything below worked
+
+    res = ID3D12CommandQueue_GetTimestampFrequency(renderer->commandQueue, &frequency);
+    if (FAILED(res) || frequency == 0) {
+        D3D12_INTERNAL_SetError(renderer, "Could not get the timestamp frequency", res);
+        return false;
+    }
+
+    SDL_zero(heapDesc);
+    heapDesc.Type = D3D12_QUERY_HEAP_TYPE_TIMESTAMP;
+    heapDesc.Count = 2 * SDL_SE_D3D12_TIMING_SLOTS;
+    heapDesc.NodeMask = 0;
+    res = ID3D12Device_CreateQueryHeap(
+        renderer->device,
+        &heapDesc,
+        D3D_GUID(D3D_IID_ID3D12QueryHeap),
+        (void **)&renderer->se.timestampHeap);
+    if (FAILED(res)) {
+        renderer->se.timestampHeap = NULL;
+        D3D12_INTERNAL_SetError(renderer, "Could not create the timestamp query heap", res);
+        return false;
+    }
+
+    SDL_zero(heapProperties);
+    heapProperties.Type = D3D12_HEAP_TYPE_READBACK;
+    heapProperties.CPUPageProperty = D3D12_CPU_PAGE_PROPERTY_UNKNOWN;
+    heapProperties.MemoryPoolPreference = D3D12_MEMORY_POOL_UNKNOWN;
+    heapProperties.CreationNodeMask = 0;
+    heapProperties.VisibleNodeMask = 0;
+
+    SDL_zero(bufferDesc);
+    bufferDesc.Dimension = D3D12_RESOURCE_DIMENSION_BUFFER;
+    bufferDesc.Alignment = D3D12_DEFAULT_RESOURCE_PLACEMENT_ALIGNMENT;
+    bufferDesc.Width = SDL_SE_D3D12_TIMESTAMP_BYTES * SDL_SE_D3D12_TIMING_SLOTS;
+    bufferDesc.Height = 1;
+    bufferDesc.DepthOrArraySize = 1;
+    bufferDesc.MipLevels = 1;
+    bufferDesc.Format = DXGI_FORMAT_UNKNOWN;
+    bufferDesc.SampleDesc.Count = 1;
+    bufferDesc.SampleDesc.Quality = 0;
+    bufferDesc.Layout = D3D12_TEXTURE_LAYOUT_ROW_MAJOR;
+    bufferDesc.Flags = D3D12_RESOURCE_FLAG_NONE;
+
+    res = ID3D12Device_CreateCommittedResource(
+        renderer->device,
+        &heapProperties,
+        D3D12_HEAP_FLAG_NONE,
+        &bufferDesc,
+        D3D12_RESOURCE_STATE_COPY_DEST,
+        NULL,
+        D3D_GUID(D3D_IID_ID3D12Resource),
+        (void **)&renderer->se.timestampReadback);
+    if (FAILED(res)) {
+        renderer->se.timestampReadback = NULL;
+        ID3D12QueryHeap_Release(renderer->se.timestampHeap);
+        renderer->se.timestampHeap = NULL;
+        D3D12_INTERNAL_SetError(renderer, "Could not create the timestamp readback buffer", res);
+        return false;
+    }
+
+    renderer->se.timestampFrequency = frequency;
+    renderer->se.timestampsFailed = false;
+    return true;
+}
+
+static void SDL_SE_D3D12_BeginTiming(SDL_GPUCommandBuffer *commandBuffer)
+{
+    D3D12CommandBuffer *d3d12CommandBuffer = (D3D12CommandBuffer *)commandBuffer;
+    D3D12Renderer *renderer = d3d12CommandBuffer->renderer;
+    Uint32 slot = SDL_SE_D3D12_TIMING_SLOTS;
+
+    if (d3d12CommandBuffer->se.timingBegun) {
+        return;
+    }
+
+    SDL_LockMutex(renderer->submitLock);
+    if (SDL_SE_D3D12_EnsureTimestamps(renderer)) {
+        // The oldest slot that no command buffer is recording into; a result
+        // nobody read is dropped.
+        for (Uint32 i = 0; i < SDL_SE_D3D12_TIMING_SLOTS; i += 1) {
+            Uint32 candidate = (renderer->se.nextTimingSlot + i) % SDL_SE_D3D12_TIMING_SLOTS;
+            if (!renderer->se.timingSlots[candidate].inUse || renderer->se.timingSlots[candidate].fence != NULL) {
+                slot = candidate;
+                break;
+            }
+        }
+        if (slot < SDL_SE_D3D12_TIMING_SLOTS) {
+            SDL_SE_D3D12_ReleaseTimingSlot(renderer, slot);
+            renderer->se.timingSlots[slot].inUse = true;
+            renderer->se.nextTimingSlot = (slot + 1) % SDL_SE_D3D12_TIMING_SLOTS;
+        }
+    }
+    SDL_UnlockMutex(renderer->submitLock);
+
+    if (slot >= SDL_SE_D3D12_TIMING_SLOTS) {
+        return;
+    }
+    d3d12CommandBuffer->se.timingSlot = slot;
+    d3d12CommandBuffer->se.timingBegun = true;
+    d3d12CommandBuffer->se.timingEnded = false;
+    ID3D12GraphicsCommandList_EndQuery(
+        d3d12CommandBuffer->graphicsCommandList,
+        renderer->se.timestampHeap,
+        D3D12_QUERY_TYPE_TIMESTAMP,
+        2 * slot);
+}
+
+static void SDL_SE_D3D12_EndTiming(SDL_GPUCommandBuffer *commandBuffer)
+{
+    D3D12CommandBuffer *d3d12CommandBuffer = (D3D12CommandBuffer *)commandBuffer;
+
+    if (!d3d12CommandBuffer->se.timingBegun || d3d12CommandBuffer->se.timingEnded) {
+        return;
+    }
+    d3d12CommandBuffer->se.timingEnded = true;
+    ID3D12GraphicsCommandList_EndQuery(
+        d3d12CommandBuffer->graphicsCommandList,
+        d3d12CommandBuffer->renderer->se.timestampHeap,
+        D3D12_QUERY_TYPE_TIMESTAMP,
+        2 * d3d12CommandBuffer->se.timingSlot + 1);
+}
+
+static void SDL_SE_D3D12_OnSubmitRecording(D3D12CommandBuffer *commandBuffer)
+{
+    D3D12Renderer *renderer = commandBuffer->renderer;
+    Uint32 slot = commandBuffer->se.timingSlot;
+
+    if (!commandBuffer->se.timingBegun) {
+        return;
+    }
+    SDL_SE_D3D12_EndTiming((SDL_GPUCommandBuffer *)commandBuffer);
+    ID3D12GraphicsCommandList_ResolveQueryData(
+        commandBuffer->graphicsCommandList,
+        renderer->se.timestampHeap,
+        D3D12_QUERY_TYPE_TIMESTAMP,
+        2 * slot,
+        2,
+        renderer->se.timestampReadback,
+        (UINT64)slot * SDL_SE_D3D12_TIMESTAMP_BYTES);
+}
+
+static void SDL_SE_D3D12_OnSubmitFence(D3D12CommandBuffer *commandBuffer)
+{
+    D3D12Renderer *renderer = commandBuffer->renderer;
+    SDL_SE_D3D12TimingSlot *timing;
+
+    if (!commandBuffer->se.timingBegun) {
+        return;
+    }
+    timing = &renderer->se.timingSlots[commandBuffer->se.timingSlot];
+    timing->fence = commandBuffer->inFlightFence;
+    (void)SDL_AtomicIncRef(&timing->fence->referenceCount);
+    SDL_zero(commandBuffer->se);
+}
+
+static void SDL_SE_D3D12_OnCancel(D3D12CommandBuffer *commandBuffer)
+{
+    if (commandBuffer->se.timingBegun) {
+        SDL_SE_D3D12_ReleaseTimingSlot(commandBuffer->renderer, commandBuffer->se.timingSlot);
+    }
+    SDL_zero(commandBuffer->se);
+}
+
+static bool SDL_SE_D3D12_GetTiming(SDL_GPURenderer *driverData, SDL_GPUFence *fence, Uint64 *duration_ns)
+{
+    D3D12Renderer *renderer = (D3D12Renderer *)driverData;
+    D3D12Fence *d3d12Fence = (D3D12Fence *)fence;
+    Uint32 slot = SDL_SE_D3D12_TIMING_SLOTS;
+    Uint64 timestamps[2] = { 0, 0 };
+    D3D12_RANGE readRange;
+    D3D12_RANGE writtenRange;
+    void *mapped = NULL;
+    bool result = false;
+    HRESULT res;
+
+    SDL_LockMutex(renderer->submitLock);
+    for (Uint32 i = 0; i < SDL_SE_D3D12_TIMING_SLOTS; i += 1) {
+        if (renderer->se.timingSlots[i].fence == d3d12Fence) {
+            slot = i;
+            break;
+        }
+    }
+    if (slot >= SDL_SE_D3D12_TIMING_SLOTS) {
+        SDL_UnlockMutex(renderer->submitLock);
+        return SDL_SetError("No GPU timing is pending for this fence");
+    }
+    if (ID3D12Fence_GetCompletedValue(d3d12Fence->handle) != D3D12_FENCE_SIGNAL_VALUE) {
+        SDL_UnlockMutex(renderer->submitLock);
+        return false;
+    }
+
+    readRange.Begin = (SIZE_T)slot * SDL_SE_D3D12_TIMESTAMP_BYTES;
+    readRange.End = readRange.Begin + SDL_SE_D3D12_TIMESTAMP_BYTES;
+    res = ID3D12Resource_Map(renderer->se.timestampReadback, 0, &readRange, &mapped);
+    if (SUCCEEDED(res) && mapped != NULL) {
+        SDL_memcpy(timestamps, (Uint8 *)mapped + readRange.Begin, sizeof(timestamps));
+        writtenRange.Begin = 0;
+        writtenRange.End = 0;
+        ID3D12Resource_Unmap(renderer->se.timestampReadback, 0, &writtenRange);
+        if (timestamps[1] >= timestamps[0]) {
+            *duration_ns = SDL_SE_TicksToNS(timestamps[1] - timestamps[0], renderer->se.timestampFrequency);
+            result = true;
+        } else {
+            SDL_SetError("GPU timestamps out of order");
+        }
+    } else {
+        D3D12_INTERNAL_SetError(renderer, "Could not map the timestamp readback buffer", res);
+    }
+    SDL_SE_D3D12_ReleaseTimingSlot(renderer, slot);
+    SDL_UnlockMutex(renderer->submitLock);
+    return result;
+}
+
+static void SDL_SE_D3D12_DestroyDevice(D3D12Renderer *renderer)
+{
+    for (Uint32 i = 0; i < SDL_SE_D3D12_TIMING_SLOTS; i += 1) {
+        SDL_SE_D3D12_ReleaseTimingSlot(renderer, i);
+    }
+    if (renderer->se.timestampReadback != NULL) {
+        ID3D12Resource_Release(renderer->se.timestampReadback);
+        renderer->se.timestampReadback = NULL;
+    }
+    if (renderer->se.timestampHeap != NULL) {
+        ID3D12QueryHeap_Release(renderer->se.timestampHeap);
+        renderer->se.timestampHeap = NULL;
+    }
+}
+
+// Frame latency and present statistics
+
+#if !(defined(SDL_PLATFORM_XBOXONE) || defined(SDL_PLATFORM_XBOXSERIES))
+
+static bool SDL_SE_D3D12_SetFrameLatency(SDL_GPURenderer *driverData, SDL_Window *window, Uint32 frames)
+{
+    D3D12Renderer *renderer = (D3D12Renderer *)driverData;
+    D3D12WindowData *windowData = D3D12_INTERNAL_FetchWindowData(window);
+    HRESULT res;
+
+    if (windowData == NULL || windowData->renderer != renderer) {
+        SET_STRING_ERROR_AND_RETURN("Cannot set the frame latency of an unclaimed window!", false);
+    }
+
+    if (windowData->se.latencyWaitable != NULL) {
+        res = IDXGISwapChain3_SetMaximumFrameLatency(windowData->swapchain, frames);
+        CHECK_D3D12_ERROR_AND_RETURN("Could not set the maximum frame latency", false);
+        windowData->se.frameLatency = frames;
+        return true;
+    }
+
+    // The waitable flag can only be given at creation: recreate the
+    // swapchain, as SetSwapchainParameters does for a new present mode.
+    windowData->se.frameLatency = frames;
+    if (!D3D12_Wait(driverData)) {
+        return false;
+    }
+    D3D12_INTERNAL_DestroySwapchain(renderer, windowData);
+    if (!D3D12_INTERNAL_CreateSwapchain(
+            renderer,
+            windowData,
+            windowData->swapchainComposition,
+            windowData->present_mode)) {
+        return false;
+    }
+    if (windowData->se.latencyWaitable == NULL) {
+        SET_STRING_ERROR_AND_RETURN("The swapchain has no frame-latency waitable object", false);
+    }
+    return true;
+}
+
+#ifdef _WIN32
+#ifndef CREATE_WAITABLE_TIMER_HIGH_RESOLUTION
+#define CREATE_WAITABLE_TIMER_HIGH_RESOLUTION 0x2
+#endif
+typedef HANDLE(WINAPI *SDL_SE_pfnCreateWaitableTimerExW)(LPSECURITY_ATTRIBUTES lpTimerAttributes, LPCWSTR lpTimerName, DWORD dwFlags, DWORD dwDesiredAccess);
+
+static HANDLE SDL_SE_D3D12_CreateWaitTimer(void)
+{
+    static SDL_SE_pfnCreateWaitableTimerExW pCreateWaitableTimerExW = NULL;
+    static bool loaded = false;
+    HANDLE timer = NULL;
+
+    if (!loaded) {
+        HMODULE module = GetModuleHandle(TEXT("kernel32.dll"));
+        if (module != NULL) {
+            pCreateWaitableTimerExW = (SDL_SE_pfnCreateWaitableTimerExW)GetProcAddress(module, "CreateWaitableTimerExW");
+        }
+        loaded = true;
+    }
+    if (pCreateWaitableTimerExW != NULL) {
+        timer = pCreateWaitableTimerExW(NULL, NULL, CREATE_WAITABLE_TIMER_HIGH_RESOLUTION, TIMER_ALL_ACCESS);
+        if (timer == NULL) {
+            // Before Windows 10 1803: a regular timer.
+            timer = pCreateWaitableTimerExW(NULL, NULL, 0, TIMER_ALL_ACCESS);
+        }
+    }
+    return timer;
+}
+#endif
+
+static SDL_SE_GPUWaitResult SDL_SE_D3D12_WaitForFrameLatency(SDL_GPURenderer *driverData, SDL_Window *window, Uint64 timeout_ns)
+{
+    D3D12WindowData *windowData = D3D12_INTERNAL_FetchWindowData(window);
+    DWORD waitResult;
+
+    if (windowData == NULL || windowData->renderer != (D3D12Renderer *)driverData ||
+        windowData->se.latencyWaitable == NULL) {
+        return SDL_SE_GPU_WAIT_UNSUPPORTED;
+    }
+
+    if (timeout_ns == 0) {
+        waitResult = WaitForSingleObjectEx(windowData->se.latencyWaitable, 0, FALSE);
+        return waitResult == WAIT_OBJECT_0 ? SDL_SE_GPU_WAIT_READY : SDL_SE_GPU_WAIT_TIMEOUT;
+    }
+
+#ifdef _WIN32
+    if (windowData->se.waitTimer == NULL) {
+        windowData->se.waitTimer = SDL_SE_D3D12_CreateWaitTimer();
+    }
+    if (windowData->se.waitTimer != NULL) {
+        LARGE_INTEGER dueTime;
+        HANDLE handles[2];
+        // A relative due time in 100 ns units, rounded down so that the wait
+        // never exceeds the timeout.
+        dueTime.QuadPart = -(LONGLONG)(timeout_ns / 100);
+        if (dueTime.QuadPart == 0) {
+            dueTime.QuadPart = -1;
+        }
+        if (SetWaitableTimer(windowData->se.waitTimer, &dueTime, 0, NULL, NULL, FALSE)) {
+            handles[0] = windowData->se.latencyWaitable;
+            handles[1] = windowData->se.waitTimer;
+            // The millisecond timeout is only a backstop for the timer.
+            waitResult = WaitForMultipleObjectsEx(2, handles, FALSE, (DWORD)SDL_min(timeout_ns / SDL_NS_PER_MS + 2, 0xFFFFFFF0u), FALSE);
+            CancelWaitableTimer(windowData->se.waitTimer);
+            return waitResult == WAIT_OBJECT_0 ? SDL_SE_GPU_WAIT_READY : SDL_SE_GPU_WAIT_TIMEOUT;
+        }
+    }
+#endif
+
+    // Millisecond resolution, rounded down.
+    waitResult = WaitForSingleObjectEx(windowData->se.latencyWaitable, (DWORD)SDL_min(timeout_ns / SDL_NS_PER_MS, 0xFFFFFFF0u), FALSE);
+    return waitResult == WAIT_OBJECT_0 ? SDL_SE_GPU_WAIT_READY : SDL_SE_GPU_WAIT_TIMEOUT;
+}
+
+static bool SDL_SE_D3D12_GetPresentStatistics(SDL_GPURenderer *driverData, SDL_Window *window, SDL_SE_GPUPresentStatistics *statistics)
+{
+    D3D12Renderer *renderer = (D3D12Renderer *)driverData;
+    D3D12WindowData *windowData = D3D12_INTERNAL_FetchWindowData(window);
+    DXGI_FRAME_STATISTICS frameStatistics;
+    UINT lastPresentCount = 0;
+    HRESULT res;
+
+    if (windowData == NULL || windowData->renderer != renderer || windowData->swapchain == NULL) {
+        SET_STRING_ERROR_AND_RETURN("Cannot read present statistics of an unclaimed window!", false);
+    }
+    if (SDL_GetWindowFlags(window) & SDL_WINDOW_MINIMIZED) {
+        return SDL_SetError("No present statistics while the window is minimized");
+    }
+
+    SDL_zero(frameStatistics);
+    res = IDXGISwapChain3_GetFrameStatistics(windowData->swapchain, &frameStatistics);
+    if (FAILED(res)) {
+        // DXGI_ERROR_FRAME_STATISTICS_DISJOINT, or nothing displayed yet.
+        return SDL_SetError("GetFrameStatistics failed " HRESULT_FMT, res);
+    }
+    if (frameStatistics.PresentCount == 0) {
+        // Also what DXGI reports for a composed (windowed) flip-model
+        // swapchain: the statistics stay zero until it presents through
+        // independent flip.
+        return SDL_SetError("DXGI reports no displayed present yet");
+    }
+    res = IDXGISwapChain3_GetLastPresentCount(windowData->swapchain, &lastPresentCount);
+    if (FAILED(res)) {
+        return SDL_SetError("GetLastPresentCount failed " HRESULT_FMT, res);
+    }
+
+    statistics->present_count = frameStatistics.PresentCount;
+    statistics->present_refresh_count = frameStatistics.PresentRefreshCount;
+    statistics->sync_refresh_count = frameStatistics.SyncRefreshCount;
+    statistics->sync_time_ns = SDL_SE_PerformanceCounterToTicksNS((Uint64)frameStatistics.SyncQPCTime.QuadPart);
+    statistics->last_present_count = lastPresentCount;
+    return true;
+}
+
+#else // Xbox: no DXGI swapchain
+
+static bool SDL_SE_D3D12_SetFrameLatency(SDL_GPURenderer *driverData, SDL_Window *window, Uint32 frames)
+{
+    (void)driverData;
+    (void)window;
+    (void)frames;
+    return SDL_Unsupported();
+}
+
+static SDL_SE_GPUWaitResult SDL_SE_D3D12_WaitForFrameLatency(SDL_GPURenderer *driverData, SDL_Window *window, Uint64 timeout_ns)
+{
+    (void)driverData;
+    (void)window;
+    (void)timeout_ns;
+    return SDL_SE_GPU_WAIT_UNSUPPORTED;
+}
+
+static bool SDL_SE_D3D12_GetPresentStatistics(SDL_GPURenderer *driverData, SDL_Window *window, SDL_SE_GPUPresentStatistics *statistics)
+{
+    (void)driverData;
+    (void)window;
+    (void)statistics;
+    return SDL_Unsupported();
+}
+
+#endif
+
+// Capabilities, status and handles
+
+static SDL_SE_GPUCapabilityFlags SDL_SE_D3D12_GetCapabilities(SDL_GPURenderer *driverData, SDL_Window *window)
+{
+    D3D12Renderer *renderer = (D3D12Renderer *)driverData;
+    SDL_SE_GPUCapabilityFlags flags = SDL_SE_GPU_CAPABILITY_TIMESTAMPS |
+                                      SDL_SE_GPU_CAPABILITY_NATIVE_HANDLES |
+                                      SDL_SE_GPU_CAPABILITY_DEVICE_STATUS;
+    (void)window;
+#if !(defined(SDL_PLATFORM_XBOXONE) || defined(SDL_PLATFORM_XBOXSERIES))
+    flags |= SDL_SE_GPU_CAPABILITY_FRAME_LATENCY_WAIT | SDL_SE_GPU_CAPABILITY_PRESENT_STATISTICS;
+    if (renderer->supportsTearing) {
+        // IMMEDIATE presents with sync interval 0 and DXGI_PRESENT_ALLOW_TEARING.
+        flags |= SDL_SE_GPU_CAPABILITY_TEARING;
+    }
+#endif
+    if (renderer->se.timestampsFailed) {
+        flags &= ~SDL_SE_GPU_CAPABILITY_TIMESTAMPS;
+    }
+    return flags;
+}
+
+static SDL_SE_GPUDeviceStatus SDL_SE_D3D12_GetDeviceStatus(SDL_GPURenderer *driverData)
+{
+    D3D12Renderer *renderer = (D3D12Renderer *)driverData;
+    HRESULT res;
+
+    if (renderer->device == NULL) {
+        return SDL_SE_GPU_DEVICE_STATUS_UNKNOWN;
+    }
+    res = ID3D12Device_GetDeviceRemovedReason(renderer->device);
+    return res == S_OK ? SDL_SE_GPU_DEVICE_STATUS_OK : SDL_SE_GPU_DEVICE_STATUS_REMOVED;
+}
+
+static bool SDL_SE_D3D12_GetNativeHandles(SDL_GPURenderer *driverData, SDL_Window *window, SDL_SE_GPUNativeHandles *handles)
+{
+    D3D12Renderer *renderer = (D3D12Renderer *)driverData;
+
+    handles->d3d12_device = renderer->device;
+    handles->d3d12_queue = renderer->commandQueue;
+#if !(defined(SDL_PLATFORM_XBOXONE) || defined(SDL_PLATFORM_XBOXSERIES))
+    if (window != NULL) {
+        D3D12WindowData *windowData = D3D12_INTERNAL_FetchWindowData(window);
+        if (windowData != NULL && windowData->renderer == renderer) {
+            handles->dxgi_swapchain = windowData->swapchain;
+        }
+    }
+#else
+    (void)window;
+#endif
+    return true;
+}
+
+const SDL_SE_GPUBackend SDL_SE_D3D12Backend = {
+    SDL_SE_D3D12_GetCapabilities,
+    SDL_SE_D3D12_SetFrameLatency,
+    SDL_SE_D3D12_WaitForFrameLatency,
+    SDL_SE_D3D12_GetPresentStatistics,
+    SDL_SE_D3D12_BeginTiming,
+    SDL_SE_D3D12_EndTiming,
+    SDL_SE_D3D12_GetTiming,
+    SDL_SE_D3D12_GetDeviceStatus,
+    SDL_SE_D3D12_GetNativeHandles
+};
+
+#endif // SDL_gpu_d3d12_se_impl_h_
