+/**
+ * # CategoryGPUSE
+ *
+ * Presentation extensions to SDL_GPU. This header is NOT part of SDL: it is
+ * added by simple-engine-2's local patch (sdl3-3.4.20-se-presentation.patch)
+ * and every function in it is prefixed SDL_SE_ so that it can never collide
+ * with a future SDL function.
+ *
+ * The extensions cover what a frame pacer needs from the swapchain and the
+ * queue that SDL_GPU does not expose:
+ *
+ * - a frame-latency wait: on Direct3D 12 the DXGI frame-latency waitable
+ *   object (the swapchain is recreated with
+ *   DXGI_SWAP_CHAIN_FLAG_FRAME_LATENCY_WAITABLE_OBJECT on first use); on
+ *   Vulkan vkWaitForPresentKHR with VK_KHR_present_id and
+ *   VK_KHR_present_wait;
+ * - present statistics with DXGI_FRAME_STATISTICS semantics (Direct3D 12:
+ *   IDXGISwapChain::GetFrameStatistics; Vulkan: VK_GOOGLE_display_timing);
+ * - per-command-buffer GPU timestamps;
+ * - the native device, queue and swapchain handles;
+ * - the device-removed (device-lost) status.
+ *
+ * Without the new calls SDL behaves exactly as without the patch. Missing
+ * driver features are reported through SDL_SE_GetGPUCapabilities and never
+ * make device creation fail.
+ *
+ * These functions are not thread safe with respect to the window they take:
+ * call them on the thread that presents that window.
+ */
+
+#ifndef SDL_gpu_se_h_
+#define SDL_gpu_se_h_
+
+#include <SDL3/SDL_stdinc.h>
+#include <SDL3/SDL_gpu.h>
+#include <SDL3/SDL_video.h>
+
+#include <SDL3/SDL_begin_code.h>
+/* Set up for C function definitions, even when using C++ */
+#ifdef __cplusplus
+extern "C" {
+#endif
+
+/**
+ * The version of this extension header. It changes whenever a declaration
+ * in it changes.
+ */
+#define SDL_SE_GPU_PRESENTATION_VERSION 1
+
+/**
+ * A set of SDL_SE_GPU_CAPABILITY_* flags.
+ */
+typedef Uint32 SDL_SE_GPUCapabilityFlags;
+
+/** SDL_SE_SetGPUFrameLatency and SDL_SE_WaitForGPUFrameLatency work. */
+#define SDL_SE_GPU_CAPABILITY_FRAME_LATENCY_WAIT (1u << 0)
+/** SDL_SE_GetGPUPresentStatistics can report statistics. */
+#define SDL_SE_GPU_CAPABILITY_PRESENT_STATISTICS (1u << 1)
+/** SDL_SE_BeginGPUTiming and SDL_SE_EndGPUTiming measure command buffers. */
+#define SDL_SE_GPU_CAPABILITY_TIMESTAMPS         (1u << 2)
+/** SDL_SE_GetGPUNativeHandles returns the backend's handles. */
+#define SDL_SE_GPU_CAPABILITY_NATIVE_HANDLES     (1u << 3)
+/** SDL_SE_GetGPUDeviceStatus can tell a removed device. */
+#define SDL_SE_GPU_CAPABILITY_DEVICE_STATUS      (1u << 4)
+/** SDL_GPU_PRESENTMODE_IMMEDIATE tears (variable refresh in a window). */
+#define SDL_SE_GPU_CAPABILITY_TEARING            (1u << 5)
+
+/**
+ * Reports which extensions work on a device and, for the window-dependent
+ * ones (present statistics, tearing), on a window it has claimed.
+ *
+ * \param device a GPU context.
+ * \param window a window claimed by the device, or NULL for the device-wide
+ *               capabilities only.
+ * \returns the supported capabilities, 0 for a NULL device.
+ */
+extern SDL_DECLSPEC SDL_SE_GPUCapabilityFlags SDLCALL SDL_SE_GetGPUCapabilities(SDL_GPUDevice *device, SDL_Window *window);
+
+/**
+ * Bounds the presentation queue of a claimed window to `frames` frames and
+ * enables SDL_SE_WaitForGPUFrameLatency.
+ *
+ * On Direct3D 12 the first call recreates the swapchain with
+ * DXGI_SWAP_CHAIN_FLAG_FRAME_LATENCY_WAITABLE_OBJECT (it waits for the GPU
+ * to go idle first) and every later swapchain of the window keeps the flag;
+ * the maximum frame latency is set with
+ * IDXGISwapChain2::SetMaximumFrameLatency. On Vulkan the following presents
+ * carry VK_KHR_present_id ids.
+ *
+ * \param device a GPU context.
+ * \param window a window claimed by the device.
+ * \param frames 1 or 2 (up to 16 is accepted).
+ * \returns true on success, false when unsupported or on failure; call
+ *          SDL_GetError() for more information.
+ */
+extern SDL_DECLSPEC bool SDLCALL SDL_SE_SetGPUFrameLatency(SDL_GPUDevice *device, SDL_Window *window, Uint32 frames);
+
+/**
+ * The outcome of SDL_SE_WaitForGPUFrameLatency.
+ */
+typedef enum SDL_SE_GPUWaitResult
+{
+    SDL_SE_GPU_WAIT_READY,      /**< The window can take a new frame. */
+    SDL_SE_GPU_WAIT_TIMEOUT,    /**< The timeout elapsed first. */
+    SDL_SE_GPU_WAIT_UNSUPPORTED /**< No frame latency was set, or no support. */
+} SDL_SE_GPUWaitResult;
+
+/**
+ * Waits until the window's presentation queue has room for a new frame
+ * under the latency set with SDL_SE_SetGPUFrameLatency, but never longer
+ * than `timeout_ns`.
+ *
+ * Direct3D 12 waits on the frame-latency waitable object (a high-resolution
+ * waitable timer bounds the wait). Vulkan waits with vkWaitForPresentKHR for
+ * the present `frames` back from the next one.
+ *
+ * \param device a GPU context.
+ * \param window a window claimed by the device.
+ * \param timeout_ns the longest wait in nanoseconds; 0 polls.
+ * \returns the outcome.
+ */
+extern SDL_DECLSPEC SDL_SE_GPUWaitResult SDLCALL SDL_SE_WaitForGPUFrameLatency(SDL_GPUDevice *device, SDL_Window *window, Uint64 timeout_ns);
+
+/**
+ * Present statistics of a window's swapchain, with the semantics of
+ * DXGI_FRAME_STATISTICS.
+ */
+typedef struct SDL_SE_GPUPresentStatistics
+{
+    Uint64 present_count;         /**< The present count of the most recently displayed present. */
+    Uint64 present_refresh_count; /**< The refresh (vblank) count at which that present was displayed. */
+    Uint64 sync_refresh_count;    /**< The refresh count when the statistics were sampled. */
+    Uint64 sync_time_ns;          /**< The time of that refresh, in the SDL_GetTicksNS() domain. */
+    Uint64 last_present_count;    /**< Presents issued on the window (IDXGISwapChain::GetLastPresentCount). */
+} SDL_SE_GPUPresentStatistics;
+
+/**
+ * Reads the present statistics of a claimed window.
+ *
+ * \param device a GPU context.
+ * \param window a window claimed by the device.
+ * \param statistics filled on success.
+ * \returns true on success; false before the first displayed present, while
+ *          the window is minimized, or when unsupported (Vulkan without
+ *          VK_GOOGLE_display_timing). On Vulkan the first call enables
+ *          display timing for the presents that follow.
+ */
+extern SDL_DECLSPEC bool SDLCALL SDL_SE_GetGPUPresentStatistics(SDL_GPUDevice *device, SDL_Window *window, SDL_SE_GPUPresentStatistics *statistics);
+
+/**
+ * Writes the start timestamp of a command buffer's GPU work.
+ *
+ * Call it once, right after the command buffer is acquired and outside any
+ * pass. The end timestamp is written by SDL_SE_EndGPUTiming, or at submit
+ * when it was not called, and both are resolved at submit. Read the result
+ * with SDL_SE_GetGPUTiming and the fence of
+ * SDL_SubmitGPUCommandBufferAndAcquireFence.
+ *
+ * \param command_buffer a command buffer.
+ */
+extern SDL_DECLSPEC void SDLCALL SDL_SE_BeginGPUTiming(SDL_GPUCommandBuffer *command_buffer);
+
+/**
+ * Writes the end timestamp of a command buffer's GPU work. Call it right
+ * before submitting, outside any pass.
+ *
+ * \param command_buffer a command buffer on which SDL_SE_BeginGPUTiming
+ *                       was called.
+ */
+extern SDL_DECLSPEC void SDLCALL SDL_SE_EndGPUTiming(SDL_GPUCommandBuffer *command_buffer);
+
+/**
+ * Reads the GPU duration of a timed command buffer once its fence has
+ * signalled. A successful read consumes the result.
+ *
+ * \param device a GPU context.
+ * \param fence the fence of the timed command buffer's submission.
+ * \param duration_ns filled with the time between the two timestamps.
+ * \returns true on success; false while the fence has not signalled, or
+ *          when the submission was not timed (or its result was read or
+ *          discarded already).
+ */
+extern SDL_DECLSPEC bool SDLCALL SDL_SE_GetGPUTiming(SDL_GPUDevice *device, SDL_GPUFence *fence, Uint64 *duration_ns);
+
+/**
+ * The device-removed status of a GPU context.
+ */
+typedef enum SDL_SE_GPUDeviceStatus
+{
+    SDL_SE_GPU_DEVICE_STATUS_OK,      /**< The device works. */
+    SDL_SE_GPU_DEVICE_STATUS_REMOVED, /**< Removed or lost: recreate it. */
+    SDL_SE_GPU_DEVICE_STATUS_UNKNOWN  /**< The backend cannot tell. */
+} SDL_SE_GPUDeviceStatus;
+
+/**
+ * Reports whether the device was removed (Direct3D 12:
+ * ID3D12Device::GetDeviceRemovedReason) or lost (Vulkan:
+ * VK_ERROR_DEVICE_LOST from any call, or from a status probe).
+ *
+ * \param device a GPU context.
+ * \returns the status.
+ */
+extern SDL_DECLSPEC SDL_SE_GPUDeviceStatus SDLCALL SDL_SE_GetGPUDeviceStatus(SDL_GPUDevice *device);
+
+/**
+ * Native handles of a GPU context. They are borrowed: valid while the
+ * device lives (the swapchain while the window stays claimed and is not
+ * resized or reconfigured), and never released by the caller.
+ */
+typedef struct SDL_SE_GPUNativeHandles
+{
+    void *d3d12_device;        /**< ID3D12Device* */
+    void *d3d12_queue;         /**< ID3D12CommandQueue* (the direct queue) */
+    void *dxgi_swapchain;      /**< IDXGISwapChain3* of the window */
+    void *vk_instance;         /**< VkInstance */
+    void *vk_physical_device;  /**< VkPhysicalDevice */
+    void *vk_device;           /**< VkDevice */
+    void *vk_queue;            /**< VkQueue (graphics, compute, transfer, present) */
+    Uint32 vk_queue_family;    /**< The queue's family index */
+    Uint64 vk_swapchain;       /**< VkSwapchainKHR of the window */
+} SDL_SE_GPUNativeHandles;
+
+/**
+ * Reads the native handles of the active backend.
+ *
+ * \param device a GPU context.
+ * \param window a window claimed by the device (for the swapchain), or NULL.
+ * \param handles filled on success; the other backend's fields are zero.
+ * \returns true on success, false when unsupported.
+ */
+extern SDL_DECLSPEC bool SDLCALL SDL_SE_GetGPUNativeHandles(SDL_GPUDevice *device, SDL_Window *window, SDL_SE_GPUNativeHandles *handles);
+
+/* Ends C function definitions when using C++ */
+#ifdef __cplusplus
+}
+#endif
+#include <SDL3/SDL_close_code.h>
+
+#endif /* SDL_gpu_se_h_ */
