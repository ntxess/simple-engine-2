+++ b/src/gpu/SDL_gpu_se.c
@@ -0,0 +1,214 @@
+/*
+  Simple DirectMedia Layer
+  Copyright (C) 1997-2026 Sam Lantinga <slouken@libsdl.org>
+
+  This software is provided 'as-is', without any express or implied
+  warranty.  In no event will the authors be held liable for any damages
+  arising from the use of this software.
+
+  Permission is granted to anyone to use this software for any purpose,
+  including commercial applications, and to alter it and redistribute it
+  freely, subject to the following restrictions:
+
+  1. The origin of this software must not be misrepresented; you must not
+     claim that you wrote the original software. If you use this software
+     in a product, an acknowledgment in the product documentation would be
+     appreciated but is not required.
+  2. Altered source versions must be plainly marked as such, and must not be
+     misrepresented as being the original software.
+  3. This notice may not be removed or altered from any source distribution.
+*/
+
+/* simple-engine-2 presentation patch: the public SDL_SE_* entry points of
+ * SDL_gpu_se.h. They validate their arguments and forward to the device's
+ * backend; a backend without the extensions reports them unsupported. */
+
+#include "SDL_internal.h"
+#include "SDL_sysgpu.h"
+#include "SDL_gpu_se_c.h"
+
+static const SDL_SE_GPUBackend *SDL_SE_GetBackend(SDL_GPUDevice *device)
+{
+    if (device == NULL || device->backend == NULL) {
+        return NULL;
+    }
+#ifdef SDL_GPU_D3D12
+    if (SDL_strcmp(device->backend, "direct3d12") == 0) {
+        return &SDL_SE_D3D12Backend;
+    }
+#endif
+#ifdef SDL_GPU_VULKAN
+    if (SDL_strcmp(device->backend, "vulkan") == 0) {
+        return &SDL_SE_VulkanBackend;
+    }
+#endif
+    return NULL;
+}
+
+static bool SDL_SE_CommandBufferIsRecording(SDL_GPUCommandBuffer *command_buffer)
+{
+    CommandBufferCommonHeader *header = (CommandBufferCommonHeader *)command_buffer;
+    if (header->submitted) {
+        SDL_assert_release(!"Command buffer already submitted!");
+        return false;
+    }
+    if (header->render_pass.in_progress || header->compute_pass.in_progress || header->copy_pass.in_progress) {
+        SDL_assert_release(!"GPU timing cannot be written inside a pass!");
+        return false;
+    }
+    return true;
+}
+
+Uint64 SDL_SE_TicksToNS(Uint64 ticks, Uint64 frequency)
+{
+    if (frequency == 0) {
+        return 0;
+    }
+    return (ticks / frequency) * SDL_NS_PER_SECOND + ((ticks % frequency) * SDL_NS_PER_SECOND) / frequency;
+}
+
+Uint64 SDL_SE_PerformanceCounterToTicksNS(Uint64 counter)
+{
+    const Uint64 frequency = SDL_GetPerformanceFrequency();
+    const Uint64 before = SDL_GetPerformanceCounter();
+    const Uint64 ticks = SDL_GetTicksNS();
+    const Uint64 after = SDL_GetPerformanceCounter();
+    const Uint64 now = before + (after - before) / 2;
+    if (counter >= now) {
+        return ticks + SDL_SE_TicksToNS(counter - now, frequency);
+    } else {
+        const Uint64 ago = SDL_SE_TicksToNS(now - counter, frequency);
+        return ago < ticks ? ticks - ago : 0;
+    }
+}
+
+SDL_SE_GPUCapabilityFlags SDL_SE_GetGPUCapabilities(SDL_GPUDevice *device, SDL_Window *window)
+{
+    const SDL_SE_GPUBackend *backend = SDL_SE_GetBackend(device);
+    if (backend == NULL) {
+        return 0;
+    }
+    return backend->GetCapabilities(device->driverData, window);
+}
+
+bool SDL_SE_SetGPUFrameLatency(SDL_GPUDevice *device, SDL_Window *window, Uint32 frames)
+{
+    const SDL_SE_GPUBackend *backend = SDL_SE_GetBackend(device);
+    if (device == NULL) {
+        return SDL_InvalidParamError("device");
+    }
+    if (window == NULL) {
+        return SDL_InvalidParamError("window");
+    }
+    if (frames < 1 || frames > 16) {
+        return SDL_SetError("Frame latency must be between 1 and 16, not %u", (unsigned int)frames);
+    }
+    if (backend == NULL) {
+        return SDL_Unsupported();
+    }
+    return backend->SetFrameLatency(device->driverData, window, frames);
+}
+
+SDL_SE_GPUWaitResult SDL_SE_WaitForGPUFrameLatency(SDL_GPUDevice *device, SDL_Window *window, Uint64 timeout_ns)
+{
+    const SDL_SE_GPUBackend *backend = SDL_SE_GetBackend(device);
+    if (backend == NULL || window == NULL) {
+        return SDL_SE_GPU_WAIT_UNSUPPORTED;
+    }
+    return backend->WaitForFrameLatency(device->driverData, window, timeout_ns);
+}
+
+bool SDL_SE_GetGPUPresentStatistics(SDL_GPUDevice *device, SDL_Window *window, SDL_SE_GPUPresentStatistics *statistics)
+{
+    const SDL_SE_GPUBackend *backend = SDL_SE_GetBackend(device);
+    if (statistics == NULL) {
+        return SDL_InvalidParamError("statistics");
+    }
+    SDL_zerop(statistics);
+    if (device == NULL) {
+        return SDL_InvalidParamError("device");
+    }
+    if (window == NULL) {
+        return SDL_InvalidParamError("window");
+    }
+    if (backend == NULL) {
+        return SDL_Unsupported();
+    }
+    return backend->GetPresentStatistics(device->driverData, window, statistics);
+}
+
+void SDL_SE_BeginGPUTiming(SDL_GPUCommandBuffer *command_buffer)
+{
+    const SDL_SE_GPUBackend *backend;
+    if (command_buffer == NULL) {
+        SDL_InvalidParamError("command_buffer");
+        return;
+    }
+    if (!SDL_SE_CommandBufferIsRecording(command_buffer)) {
+        return;
+    }
+    backend = SDL_SE_GetBackend(((CommandBufferCommonHeader *)command_buffer)->device);
+    if (backend != NULL) {
+        backend->BeginTiming(command_buffer);
+    }
+}
+
+void SDL_SE_EndGPUTiming(SDL_GPUCommandBuffer *command_buffer)
+{
+    const SDL_SE_GPUBackend *backend;
+    if (command_buffer == NULL) {
+        SDL_InvalidParamError("command_buffer");
+        return;
+    }
+    if (!SDL_SE_CommandBufferIsRecording(command_buffer)) {
+        return;
+    }
+    backend = SDL_SE_GetBackend(((CommandBufferCommonHeader *)command_buffer)->device);
+    if (backend != NULL) {
+        backend->EndTiming(command_buffer);
+    }
+}
+
+bool SDL_SE_GetGPUTiming(SDL_GPUDevice *device, SDL_GPUFence *fence, Uint64 *duration_ns)
+{
+    const SDL_SE_GPUBackend *backend = SDL_SE_GetBackend(device);
+    if (duration_ns == NULL) {
+        return SDL_InvalidParamError("duration_ns");
+    }
+    *duration_ns = 0;
+    if (device == NULL) {
+        return SDL_InvalidParamError("device");
+    }
+    if (fence == NULL) {
+        return SDL_InvalidParamError("fence");
+    }
+    if (backend == NULL) {
+        return SDL_Unsupported();
+    }
+    return backend->GetTiming(device->driverData, fence, duration_ns);
+}
+
+SDL_SE_GPUDeviceStatus SDL_SE_GetGPUDeviceStatus(SDL_GPUDevice *device)
+{
+    const SDL_SE_GPUBackend *backend = SDL_SE_GetBackend(device);
+    if (backend == NULL) {
+        return SDL_SE_GPU_DEVICE_STATUS_UNKNOWN;
+    }
+    return backend->GetDeviceStatus(device->driverData);
+}
+
+bool SDL_SE_GetGPUNativeHandles(SDL_GPUDevice *device, SDL_Window *window, SDL_SE_GPUNativeHandles *handles)
+{
+    const SDL_SE_GPUBackend *backend = SDL_SE_GetBackend(device);
+    if (handles == NULL) {
+        return SDL_InvalidParamError("handles");
+    }
+    SDL_zerop(handles);
+    if (device == NULL) {
+        return SDL_InvalidParamError("device");
+    }
+    if (backend == NULL) {
+        return SDL_Unsupported();
+    }
+    return backend->GetNativeHandles(device->driverData, window, handles);
+}
