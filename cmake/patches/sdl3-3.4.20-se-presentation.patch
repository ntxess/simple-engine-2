+/* simple-engine-2 presentation patch, Direct3D 12 part 1 of 2: the state the
+ * backend's structures carry for SDL_gpu_se.h, and the hooks the backend
+ * calls. Included by SDL_gpu_d3d12.c once, after D3D12Fence; the hooks are
+ * defined in SDL_gpu_d3d12_se_impl.h, included at the end of that file. */
+
+#ifndef SDL_gpu_d3d12_se_h_
+#define SDL_gpu_d3d12_se_h_
+
+#include "../SDL_gpu_se_c.h"
+
+// Timed command buffers whose result can be outstanding at once.
+#define SDL_SE_D3D12_TIMING_SLOTS 64
+
+struct D3D12WindowData;
+
+// D3D12WindowData::se
+typedef struct SDL_SE_D3D12WindowData
+{
+    // Requested maximum frame latency; 0 until SDL_SE_SetGPUFrameLatency.
+    // Every swapchain created while it is set has the waitable flag.
+    Uint32 frameLatency;
+    // The swapchain's frame-latency waitable object, or NULL.
+    HANDLE latencyWaitable;
+    // A high-resolution waitable timer that bounds waits on it.
+    HANDLE waitTimer;
+} SDL_SE_D3D12WindowData;
+
+// D3D12CommandBuffer::se, zeroed at acquire.
+typedef struct SDL_SE_D3D12CommandBufferData
+{
+    Uint32 timingSlot;
+    bool timingBegun;
+    bool timingEnded;
+} SDL_SE_D3D12CommandBufferData;
+
+typedef struct SDL_SE_D3D12TimingSlot
+{
+    // Taken by a command buffer that is being recorded.
+    bool inUse;
+    // Its submission's fence, referenced until the result is read or the
+    // slot is reused.
+    D3D12Fence *fence;
+} SDL_SE_D3D12TimingSlot;
+
+// D3D12Renderer::se. Guarded by the renderer's submitLock.
+typedef struct SDL_SE_D3D12RendererData
+{
+    // Two timestamps per slot, resolved at submit into the readback buffer.
+    ID3D12QueryHeap *timestampHeap;
+    ID3D12Resource *timestampReadback;
+    Uint64 timestampFrequency;
+    bool timestampsFailed;
+    Uint32 nextTimingSlot;
+    SDL_SE_D3D12TimingSlot timingSlots[SDL_SE_D3D12_TIMING_SLOTS];
+} SDL_SE_D3D12RendererData;
+
+// Hooks, in the order the backend calls them.
+#if !(defined(SDL_PLATFORM_XBOXONE) || defined(SDL_PLATFORM_XBOXSERIES))
+// Extra DXGI_SWAP_CHAIN_FLAGs for CreateSwapChainForHwnd and ResizeBuffers.
+static UINT SDL_SE_D3D12_SwapchainFlags(struct D3D12WindowData *windowData);
+// After a swapchain was created: frame latency and the waitable.
+static void SDL_SE_D3D12_OnSwapchainCreated(struct D3D12WindowData *windowData);
+// Before a swapchain is released.
+static void SDL_SE_D3D12_OnSwapchainDestroyed(struct D3D12WindowData *windowData);
+#endif
+// In Submit, before the command list is closed: end and resolve timing.
+static void SDL_SE_D3D12_OnSubmitRecording(D3D12CommandBuffer *commandBuffer);
+// In Submit, once the submission's fence exists: bind it to the timing.
+static void SDL_SE_D3D12_OnSubmitFence(D3D12CommandBuffer *commandBuffer);
+// In Cancel: give back the timing slot.
+static void SDL_SE_D3D12_OnCancel(D3D12CommandBuffer *commandBuffer);
+// In DestroyDevice, after the GPU is idle and the windows are released.
+static void SDL_SE_D3D12_DestroyDevice(D3D12Renderer *renderer);
+
+#endif // SDL_gpu_d3d12_se_h_
