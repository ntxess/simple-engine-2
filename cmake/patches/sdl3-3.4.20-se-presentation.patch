+
+/* simple-engine-2 presentation patch, Vulkan part 1 of 2: the state the
+ * backend's structures carry for SDL_gpu_se.h, and the hooks the backend
+ * calls. Included by SDL_gpu_vulkan.c once, after VulkanFenceHandle; the
+ * hooks are defined in SDL_gpu_vulkan_se_impl.h, included at the end of
+ * that file. */
+
+#ifndef SDL_gpu_vulkan_se_h_
+#define SDL_gpu_vulkan_se_h_
+
+#include "../SDL_gpu_se_c.h"
+
+// Timed command buffers whose result can be outstanding at once.
+#define SDL_SE_VULKAN_TIMING_SLOTS 64
+// Optional device extensions the patch may add at device creation.
+#define SDL_SE_VULKAN_MAX_ADDED_EXTENSIONS 3
+
+struct WindowData;
+struct VulkanCommandBuffer;
+
+// WindowData::se
+typedef struct SDL_SE_VulkanWindowData
+{
+    // Requested frame latency; 0 until SDL_SE_SetGPUFrameLatency. While it
+    // is set, presents carry VK_KHR_present_id ids.
+    Uint32 frameLatency;
+    // Presents issued on the window; each one's number is its present id.
+    Uint64 presentCount;
+    // The last present that carried an id, and the first one on the
+    // current swapchain (0: none yet).
+    Uint64 lastPresentId;
+    Uint64 firstPresentIdOfSwapchain;
+    // VK_GOOGLE_display_timing, enabled by the first statistics query.
+    bool displayTimingRequested;
+    bool haveDisplayTiming;
+    Uint32 lastTimingPresentId;
+    Uint64 lastActualPresentTime;
+    Uint64 refreshDuration;
+    Uint64 baseActualPresentTime;
+    Uint64 baseRefreshCount;
+} SDL_SE_VulkanWindowData;
+
+// VulkanCommandBuffer::se, zeroed at acquire.
+typedef struct SDL_SE_VulkanCommandBufferData
+{
+    Uint32 timingSlot;
+    bool timingBegun;
+    bool timingEnded;
+} SDL_SE_VulkanCommandBufferData;
+
+typedef struct SDL_SE_VulkanTimingSlot
+{
+    bool inUse;
+    VulkanFenceHandle *fence;
+} SDL_SE_VulkanTimingSlot;
+
+// VulkanRenderer::se. The timing slots are guarded by submitLock.
+typedef struct SDL_SE_VulkanRendererData
+{
+    bool presentId;     // VK_KHR_present_id with its feature enabled
+    bool presentWait;   // VK_KHR_present_wait with its feature enabled
+    bool displayTiming; // VK_GOOGLE_display_timing enabled
+
+    PFN_vkWaitForPresentKHR vkWaitForPresentKHR;
+    PFN_vkGetPastPresentationTimingGOOGLE vkGetPastPresentationTimingGOOGLE;
+    PFN_vkGetRefreshCycleDurationGOOGLE vkGetRefreshCycleDurationGOOGLE;
+    PFN_vkCreateQueryPool vkCreateQueryPool;
+    PFN_vkDestroyQueryPool vkDestroyQueryPool;
+    PFN_vkCmdResetQueryPool vkCmdResetQueryPool;
+    PFN_vkCmdWriteTimestamp vkCmdWriteTimestamp;
+    PFN_vkGetQueryPoolResults vkGetQueryPoolResults;
+
+    VkQueryPool timestampPool;
+    Uint32 timestampValidBits;
+    float timestampPeriod;
+    bool timestampsFailed;
+    Uint32 nextTimingSlot;
+    SDL_SE_VulkanTimingSlot timingSlots[SDL_SE_VULKAN_TIMING_SLOTS];
+
+    // An unsubmitted fence whose status reports a lost device.
+    VkFence statusFence;
+    SDL_AtomicInt deviceLost;
+} SDL_SE_VulkanRendererData;
+
+// Device creation: the optional extensions and their features, appended to
+// the create info and taken out again if vkCreateDevice fails with them.
+typedef struct SDL_SE_VulkanDeviceCreate
+{
+    const char **extensionNames;
+    const char *const *originalExtensionNames;
+    Uint32 originalExtensionCount;
+    const void *originalNext;
+    VkPhysicalDevicePresentIdFeaturesKHR presentIdFeatures;
+    VkPhysicalDevicePresentWaitFeaturesKHR presentWaitFeatures;
+    bool presentId;
+    bool presentWait;
+    bool displayTiming;
+} SDL_SE_VulkanDeviceCreate;
+
+// The pNext chain of one present.
+typedef struct SDL_SE_VulkanPresentChain
+{
+    Uint64 presentIdValue;
+    VkPresentIdKHR presentId;
+    VkPresentTimeGOOGLE presentTime;
+    VkPresentTimesInfoGOOGLE presentTimes;
+} SDL_SE_VulkanPresentChain;
+
+// Hooks, in the order the backend calls them.
+// Before vkCreateDevice: append the optional extensions and features.
+static void SDL_SE_VULKAN_PrepareDeviceCreate(VulkanRenderer *renderer, VkDeviceCreateInfo *createInfo, SDL_SE_VulkanDeviceCreate *data);
+// After vkCreateDevice failed: undo the additions; true if a retry differs.
+static bool SDL_SE_VULKAN_RevertDeviceCreate(VkDeviceCreateInfo *createInfo, SDL_SE_VulkanDeviceCreate *data);
+// After vkCreateDevice (success or not): load entry points, free the list.
+static void SDL_SE_VULKAN_FinishDeviceCreate(VulkanRenderer *renderer, SDL_SE_VulkanDeviceCreate *data, bool created);
+// At the end of a successful swapchain creation.
+static void SDL_SE_VULKAN_OnSwapchainCreated(struct WindowData *windowData);
+// The pNext of a VkPresentInfoKHR for the window.
+static const void *SDL_SE_VULKAN_PresentNext(VulkanRenderer *renderer, struct WindowData *windowData, SDL_SE_VulkanPresentChain *chain);
+// In Submit, before vkEndCommandBuffer: write a missing end timestamp.
+static void SDL_SE_VULKAN_OnSubmitRecording(struct VulkanCommandBuffer *commandBuffer);
+// In Submit, once the submission's fence exists: bind it to the timing.
+static void SDL_SE_VULKAN_OnSubmitFence(struct VulkanCommandBuffer *commandBuffer);
+// In Cancel: give back the timing slot.
+static void SDL_SE_VULKAN_OnCancel(struct VulkanCommandBuffer *commandBuffer);
+// Every failed call checked by CHECK_VULKAN_ERROR_AND_RETURN.
+static void SDL_SE_VULKAN_OnResult(VulkanRenderer *renderer, VkResult result);
+// In DestroyDevice, after the GPU is idle and the windows are released.
+static void SDL_SE_VULKAN_DestroyDevice(VulkanRenderer *renderer);
+
+#endif // SDL_gpu_vulkan_se_h_
