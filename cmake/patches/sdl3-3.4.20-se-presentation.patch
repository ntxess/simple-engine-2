+  Copyright (C) 1997-2026 Sam Lantinga <slouken@libsdl.org>
+
+  This software is provided 'as-is', without any express or implied
+  warranty.  In no event will the authors be held liable for any damages
+  arising from the use of this software.
+
+  Permission is granted to anyone to use this software for any purpose,
+  including commercial applications, and to alter it and redistribute it
+  freely, subject to the following restrictions:
+
+  1. The origin of this software must not be misrepresented; you must not
+     claim that you wrote the original software. If you use this software
+     in a product, an acknowledgment in the product documentation would be
+     appreciated but is not required.
+  2. Altered source versions must be plainly marked as such, and must not be
+     misrepresented as being the original software.
+  3. This notice may not be removed or altered from any source distribution.
+*/
+
+/* simple-engine-2 presentation patch: the backend interface behind
+ * SDL_gpu_se.h. Each backend that supports the extensions defines one
+ * SDL_SE_GPUBackend in a file included at the end of its own source file
+ * (it needs the backend's private structures); SDL_gpu_se.c picks it by the
+ * device's backend name. */
+
+#ifndef SDL_gpu_se_c_h_
+#define SDL_gpu_se_c_h_
+
+#include "SDL_sysgpu.h"
+#include <SDL3/SDL_gpu_se.h>
+
+typedef struct SDL_SE_GPUBackend
+{
+    SDL_SE_GPUCapabilityFlags (*GetCapabilities)(SDL_GPURenderer *driverData, SDL_Window *window);
+    bool (*SetFrameLatency)(SDL_GPURenderer *driverData, SDL_Window *window, Uint32 frames);
+    SDL_SE_GPUWaitResult (*WaitForFrameLatency)(SDL_GPURenderer *driverData, SDL_Window *window, Uint64 timeout_ns);
+    bool (*GetPresentStatistics)(SDL_GPURenderer *driverData, SDL_Window *window, SDL_SE_GPUPresentStatistics *statistics);
+    void (*BeginTiming)(SDL_GPUCommandBuffer *commandBuffer);
+    void (*EndTiming)(SDL_GPUCommandBuffer *commandBuffer);
+    bool (*GetTiming)(SDL_GPURenderer *driverData, SDL_GPUFence *fence, Uint64 *duration_ns);
+    SDL_SE_GPUDeviceStatus (*GetDeviceStatus)(SDL_GPURenderer *driverData);
+    bool (*GetNativeHandles)(SDL_GPURenderer *driverData, SDL_Window *window, SDL_SE_GPUNativeHandles *handles);
+} SDL_SE_GPUBackend;
+
+#ifdef __cplusplus
+extern "C" {
+#endif
+
+extern const SDL_SE_GPUBackend SDL_SE_D3D12Backend;
+extern const SDL_SE_GPUBackend SDL_SE_VulkanBackend;
+
+// Converts a SDL_GetPerformanceCounter() value (QPC on Windows) into the
+// SDL_GetTicksNS() domain.
+extern Uint64 SDL_SE_PerformanceCounterToTicksNS(Uint64 counter);
+
+// Converts a count of `frequency` ticks per second into nanoseconds without
+// overflowing for any realistic count.
+extern Uint64 SDL_SE_TicksToNS(Uint64 ticks, Uint64 frequency);
+
+#ifdef __cplusplus
+}
+#endif
+
+#endif // SDL_gpu_se_c_h_
