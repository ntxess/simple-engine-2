# File > Open over a dirty document (R4 of the M10-M14 review; ADR-113):
# the open waits for the unsaved-changes prompt. Cancel keeps the changes;
# Save saves them through the lane and opens once the save completed;
# Don't Save opens at once. The document is a copy of the sandbox
# (--scene-copy); the opens take the repository's sandbox, which is never
# saved.
set 5a4db0c5-0000-4000-8000-000000000000 Transform {"pos":{"x":321,"y":250},"rot":0,"scale":{"x":1,"y":1},"teleport_tick":0}
expect-dirty yes
dialog-open open
dialog-callback assets/scenes/sandbox.scene.json
wait-frames 2
expect-open-prompt yes
answer-open cancel
wait-frames 2
expect-open-prompt no
expect-dirty yes
# Save, then open.
dialog-open open
dialog-callback assets/scenes/sandbox.scene.json
wait-frames 2
expect-open-prompt yes
expect-dirty yes
answer-open save
wait-saves
wait-frames 2
expect-open-prompt no
expect-dirty no
expect-hash document initial
expect-recovery no
# Don't Save: the opened sandbox's change is dropped.
set 5a4db0c5-0000-4000-8000-000000000000 Transform {"pos":{"x":123,"y":250},"rot":0,"scale":{"x":1,"y":1},"teleport_tick":0}
expect-dirty yes
answer-open discard
dialog-open open
dialog-callback assets/scenes/sandbox.scene.json
wait-frames 2
expect-open-prompt no
expect-dirty no
expect-hash document initial
quit discard
